{
  "manifest_version": 3,
  "name": "Astra \u2014 Summon Meeting Bot",
  "version": "1.0.0",
  "description": "Send a briefed Astra bot into the Google Meet you are looking at.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:3000/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_title": "Astra",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
