# ---------------------------------------------------------------------------
# Astra — copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key. SERVER ONLY -- it bypasses every RLS policy in the schema.
# Used by the pre-context engine to read team_integrations after it has already
# verified, with the user's own session, that the caller leads that team.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 32 random bytes, base64. Encrypts the GitHub/Jira/Slack tokens before they
# are written to team_integrations. Generate one with:
#     npm run keygen
# Rotating this key makes every stored token undecryptable -- re-enter them.
ASTRA_ENCRYPTION_KEY=

# Where the app is reachable, used to build the Supabase auth redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
