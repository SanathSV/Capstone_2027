# ---------------------------------------------------------------------------
# Astra — copy to .env.local and fill in. .env.local is gitignored.
# ---------------------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------
# The URL is the BARE project origin -- no path, no trailing slash:
#
#     right:  https://abcdefgh.supabase.co
#     wrong:  https://abcdefgh.supabase.co/rest/v1     <- the "RESTful endpoint"
#
# The dashboard's Data API page shows a "RESTful endpoint" ending in /rest/v1.
# That is not this value: supabase-js appends /auth/v1 and /rest/v1 itself, so
# pasting it produces /rest/v1/auth/v1/otp and every sign-in 404s.
#
# Keys: Dashboard -> Settings -> API Keys. Depending on how new your project is
# you will see either:
#
#   new format:     sb_publishable_...   and  sb_secret_...
#   legacy format:  eyJhbGciOi...        (anon / service_role JWTs)
#
# Astra works with either. If you see both, prefer the new format — it rotates
# independently of the JWT secret. Put the publishable/anon value in the first
# slot and the secret/service_role value in the second.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY -- this one bypasses every RLS policy in the schema. It is read by
# the pre-context engine to decrypt team_integrations, but only after the
# caller's own session has already proved they lead that team. Never expose it
# to the browser, and never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Astra ------------------------------------------------------------------
# 32 random bytes, base64. Encrypts the GitHub/Jira/Slack tokens before they are
# written to team_integrations. Generate another with: npm run keygen
# Changing this makes every already-stored token undecryptable -- you would have
# to re-enter them on each team page.
ASTRA_ENCRYPTION_KEY=

# Where the app is reachable. Used to build the Supabase auth redirect URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bot account authentication --------------------------------------------
# Signing the meeting bot into Google opens a REAL browser window for you to
# type a password and complete 2FA in. That only works where you can see the
# screen -- i.e. when Astra runs on your own machine -- so it is off unless you
# opt in here. On a deployed server, leave this unset: the button then explains
# why rather than hanging on a window that can never appear.
ASTRA_ALLOW_LOCAL_BOT_AUTH=

# The interpreter that has Playwright installed (see bot-auth/requirements.txt).
# Defaults to `python` on Windows and `python3` elsewhere; set it if yours lives
# in a virtualenv.
# ASTRA_PYTHON=C:/path/to/.venv/Scripts/python.exe

# --- Captured extension payloads (TEMPORARY, Phase 1 only) -----------------
# Every POST to /api/bot/summon is written to _sent_data_extension/ as JSON, so
# you can inspect what the Chrome extension actually sent -- or feed it straight
# to a bot container. The directory gitignores itself.
#
# Those files contain a LIVE GOOGLE SESSION, same as auth.json. Set REDACT=1 to
# blank the cookie values before sharing a payload; set REQUESTS=0 to write
# nothing at all.
# ASTRA_DUMP_REQUESTS=0
# ASTRA_DUMP_REDACT=1
