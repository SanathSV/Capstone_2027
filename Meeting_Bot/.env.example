# Copy this file to `.env` and fill it in. `.env` is gitignored -- your keys
# stay on your machine. Nothing here is shared between collaborators: every
# person picks their own values.
#
#     PowerShell:  Copy-Item .env.example .env
#     bash/zsh:    cp .env.example .env
#
# `docker compose` reads this file automatically. Your own terminal does not,
# so tester.py needs the key passed with --key (or exported -- see RUNNING.md).

# ---------------------------------------------------------------- the keys --
# Required by every call to the API. Invent any long random string.
# Empty means the server is open to anyone who can reach port 8080.
MEET_API_KEY=change-me-to-something-random

# Shared between the container and host_listener.py so the container can prove
# it is the one pushing transcripts to you. Invent a second random string, and
# start host_listener.py with the same value: --key <this>
MEET_CALLBACK_KEY=change-me-too

# ------------------------------------------------------------- the assistant -
# Wake-word assistant. 1 = on. Needs Ollama running on your machine.
MEET_ASSISTANT=1
MEET_WAKE_WORDS=astra,yo bot
MEET_OLLAMA_MODEL=llama3.2
# host.docker.internal is how the container reaches Ollama on your host.
MEET_OLLAMA_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------- behaviour --
# Language Meet should transcribe, e.g. Telugu, Hindi, Spanish. Meet does not
# auto-detect. Empty = the Google account's default.
MEET_CAPTION_LANGUAGE=

# 1 = only ever join as the signed-in account in creds/. See SECURITY.md.
MEET_REQUIRE_LOGIN=1

# Concurrent meetings per container. Scale out with replicas, not up.
MEET_MAX_SESSIONS=1

# Where the container pushes transcripts. "" disables pushing (poll the API
# instead). The port must match host_listener.py --port.
MEET_CALLBACK_URL=http://host.docker.internal:9000/ingest
