# --- App ---
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PORT=8000

# --- CORS ---
# Comma-separated. The web app plus any extension origins.
# In development every chrome-extension:// origin is allowed regardless.
CORS_ORIGINS=http://localhost:3000
CHROME_EXTENSION_IDS=

# --- PostgreSQL (Supabase) ---
# Must be a role WITHOUT BYPASSRLS, or tenant isolation is silently disabled.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/astra
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (Upstash) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET=change-me
BOT_API_KEY=change-me
