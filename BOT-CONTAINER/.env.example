# =============================================================================
# Astra BOT-CONTAINER — environment
#
#   cp .env.example .env      then fill in the three REQUIRED values.
#
# Everything else has a working default; the container starts and joins a
# meeting with only those three set. Full explanations in ENVIRONMENT.md.
#
# .env is gitignored. SUPABASE_SERVICE_ROLE_KEY bypasses every row-level
# security policy in the database — treat this file like a password.
# =============================================================================

# -- REQUIRED -----------------------------------------------------------------

# Supabase → Project Settings → Data API → Project URL.
# The BARE origin. Not the "RESTful endpoint" ending in /rest/v1.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase → Project Settings → API Keys → `service_role` (click to reveal).
# NOT the anon/publishable key: the container writes transcripts for meetings it
# is not a member of, and RLS would refuse every insert.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio → https://aistudio.google.com/apikey → "Create API key".
GEMINI_API_KEY=

# -- HTTP ---------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# Shared secret for POST /api/start-bot. Unset = the endpoint is open, which is
# acceptable only when it is bound to 127.0.0.1. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# and paste the same value into chrome-extension/config.js as BOT_API_TOKEN.
BOT_API_TOKEN=

# Comma-separated allow-list, or * . A Chrome extension's origin contains its
# install id and differs per machine, so * is the practical default — the shared
# secret above is what actually protects the endpoint.
ALLOWED_ORIGINS=*

# -- Gemini -------------------------------------------------------------------
# An alias, not a pinned version: Google retires models on its own schedule
# (gemini-2.0-flash, the previous default, now 404s). Pin an exact id only if you
# need byte-stable answers. Avoid the "thinking" models (gemini-3.6-flash and
# friends) unless you also raise GEMINI_MAX_OUTPUT_TOKENS — reasoning tokens come
# out of the same budget and answers arrive truncated mid-sentence.
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=512

# -- Browser ------------------------------------------------------------------
# 1 in Docker, always. 0 opens a real window — useful on a laptop when a join is
# failing and you want to watch it happen.
BOT_HEADLESS=1
BOT_DISPLAY_NAME=Astra Notetaker

# Playwright's headless Chromium otherwise announces itself as HeadlessChrome in
# every request. That does not resurrect a dead session, but it is a standing
# "this is a robot" signal to Google, and those shorten how long an exported
# session survives.
BOT_USER_AGENT=

# Probe the Google session before opening the meeting. Three seconds, and it
# turns "Never found a Join button" into "your bot session was revoked".
BOT_VERIFY_SESSION=1

# When Google refuses the saved session, join as a guest instead of giving up.
# A guest bot needs admitting by hand and joins under BOT_DISPLAY_NAME, but it
# still captions, transcribes and answers. Set to 0 to make it a hard failure.
BOT_ALLOW_GUEST_FALLBACK=1
BOT_JOIN_TIMEOUT_MS=45000
# How long to sit in the lobby waiting to be admitted (5 minutes).
BOT_ADMIT_TIMEOUT_MS=300000
# Hang up after this long as the only participant. 0 disables.
BOT_ALONE_LEAVE_MS=120000
# Hard ceiling on one meeting (4 hours), so a forgotten bot cannot run all week.
BOT_MAX_MEETING_MS=14400000
# Meet transcribes the language it is configured for; it does not auto-detect.
# Leave empty to use whatever the account is already set to.
BOT_CAPTION_LANGUAGE=

# Meet only starts a NEW caption block when the SPEAKER changes, so while one
# person talks everything piles into one growing block. A block unchanged for
# this long emits the part not yet sent — this is what turns a monologue into
# lines instead of one blob at hang-up.
BOT_CAPTION_SETTLE_MS=2000

# -- Wake word ----------------------------------------------------------------
# Longest phrase wins, so "hey astra" is matched before the bare "astra".
BOT_WAKE_WORDS=hey astra,ok astra,astra
BOT_COMPLETION_PHRASES=that's all,thats all,that's it,thats it,over to you,thank you astra
# The spec's five-second silence threshold: how long the captions must be
# completely still — including mid-sentence updates — before a question is
# considered finished.
BOT_SILENCE_MS=5000
BOT_MIN_QUERY_CHARS=3

# -- The conversation protocol ------------------------------------------------
# What the bot says the moment it hears its name, before it knows the question.
# Staying silent for eight seconds while someone talks is indistinguishable from
# not having heard them, and they start over.
BOT_GREETING=Yeah, how can I help you?

# Echo the question back and wait for a yes/no before spending a model call.
# Captions mishear names and jargon constantly, and an answer to a misheard
# question is worse than none — it is confidently wrong in front of the room.
BOT_CONFIRM=1
# How long to wait for that yes/no before going ahead anyway.
BOT_CONFIRM_TIMEOUT_MS=7000
BOT_YES_WORDS=yes,yeah,yep,yup,ya,correct,right,that's right,exactly,go ahead,sure
BOT_NO_WORDS=no,nope,nah,not really,wrong,that's wrong,incorrect,not quite

# -- In-memory context --------------------------------------------------------
# Past [question, answer] PAIRS kept for follow-ups. Never read back from
# Supabase during a live meeting.
BOT_MAX_CONTEXT_TURNS=12
BOT_MAX_PRECONTEXT_CHARS=24000

# -- Chat output --------------------------------------------------------------
BOT_CHAT_CHUNK_CHARS=900
BOT_CHAT_MAX_CHUNKS=3

# -- Operations ---------------------------------------------------------------
# Each session is a real browser. Three is already a lot for a laptop.
BOT_MAX_SESSIONS=3
BOT_DATA_DIR=data
BOT_DEBUG_SHOTS=1

# If nothing has been heard after 90s, dump the live caption DOM to
# data/debug/captions-*.json. This is how stale selectors get fixed from what is
# actually on the page instead of by guessing — Google rotates the class names.
BOT_DEBUG_CAPTIONS=1
BOT_CAPTION_DIAGNOSTIC_MS=90000
# ⚠ Writes the whole summon payload — including a live Google session — to
# data/payloads/. Debugging only.
BOT_DUMP_PAYLOADS=0
# error | warn | info | debug   (debug prints every caption line)
# Print every finalised caption line (📝) and every Supabase row (💾).
# Both on by default: "what did it hear?" and "did that reach the database?" are
# the first two questions asked of a transcription bot that looks wrong.
BOT_LOG_TRANSCRIPT=1
BOT_LOG_DB=1

# error | warn | info | debug   (debug adds interim caption deltas)
LOG_LEVEL=info
TZ=UTC
